---
import type { MarkdownHeading } from "astro";
import { AUTHOR } from "~/site";
import type { CollectionEntry } from "astro:content";

import Shell from "./Shell.astro";
import FrontMatter from "./FrontMatter.astro";
import { RAIL_SEPARATOR } from "./rail";
import TableOfContents from "~/components/TableOfContents.astro";
import Bibliography from "~/components/mdx/links/Bibliography.astro";
import type { LinkMeta } from "~/components/mdx/links/types";
import { day } from "~/content/schedule";

export interface Props {
    /** The page's own frontmatter, plus what the remark plugins added to it. */
    frontmatter: CollectionEntry<"pages">["data"] & {
        links: string[];
        linkMeta: LinkMeta;
    };
    headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;
const author = frontmatter.author ?? AUTHOR;

/**
 * What identifies this copy of the page: when it was published, when it was
 * last revised if it has been, and the revision it was built from.
 * prelude.scss sets it down the right rail — see fixtures/design.mdx, Annotation.
 * Either of the last two may be absent — an unedited page, a build outside a
 * git checkout — and simply drops out.
 */
const rail = [
    day(frontmatter.published),
    frontmatter.updated && `ed ${day(frontmatter.updated)}`,
    __GIT_REVISION__ && `rev ${__GIT_REVISION__}`,
]
    .filter(Boolean)
    .join(RAIL_SEPARATOR);
---

<Shell
    title={frontmatter.title}
    description={frontmatter.abstract}
    author={author}
    host="site"
>
    <TableOfContents slot="toc" headings={headings} />
    <article data-rail={rail}>
        <FrontMatter
            title={frontmatter.title}
            author={author}
            abstract={frontmatter.abstract}
            headings={headings}
        />

        <slot />

        {
            frontmatter.bibliography && (
                <Bibliography
                    linkMeta={frontmatter.linkMeta}
                    citations={frontmatter.citation}
                />
            )
        }
    </article>
</Shell>
