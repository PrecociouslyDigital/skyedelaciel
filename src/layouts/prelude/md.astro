---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import Shell from "./Shell.astro";
import { RAIL_SEPARATOR } from "./rail";
import TableOfContents from "~/components/TableOfContents.astro";
import Bibliography from "~/components/mdx/links/Bibliography.astro";
import type { LinkMeta } from "~/components/mdx/links/types";

export interface Props {
    /** The page's own frontmatter, plus what the remark plugins added to it. */
    frontmatter: CollectionEntry<"pages">["data"] & {
        links: string[];
        linkMeta: LinkMeta;
    };
    headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;
const author = frontmatter.author ?? "Skye De La Ciel";

/* A frontmatter date is a day, not an instant: it parses to UTC midnight, and
   reading it back out in UTC is what returns the day that was written down. */
const day = (date: Date) => date.toISOString().slice(0, 10);

/**
 * What identifies this copy of the page: when it was published, when it was
 * last revised if it has been, and the revision it was built from.
 * prelude.scss sets it down the right rail — see design.mdx, Annotation.
 * Either of the last two may be absent — an unedited page, a build outside a
 * git checkout — and simply drops out.
 */
const rail = [
    day(frontmatter.published),
    frontmatter.updated && `ed ${day(frontmatter.updated)}`,
    __GIT_REVISION__ && `rev ${__GIT_REVISION__}`,
]
    .filter(Boolean)
    .join(RAIL_SEPARATOR);
---

<Shell
    title={frontmatter.title}
    description={frontmatter.abstract}
    author={author}
    host="site"
>
    <TableOfContents slot="toc" headings={headings} />
    <article data-rail={rail}>
        <header class="front-matter">
            <div class="title-line">
                <h1 class="title">{frontmatter.title}</h1>
                <span class="author">{author}</span>
            </div>
            <p class="abstract">{frontmatter.abstract}</p>
            <nav class="toc toc-portrait" aria-label="Table of contents">
                <input type="checkbox" id="toc-toggle" />
                <label for="toc-toggle">Contents</label>
                <TableOfContents headings={headings} />
            </nav>
        </header>

        <slot />

        {
            frontmatter.bibliography && (
                <Bibliography
                    linkMeta={frontmatter.linkMeta}
                    citations={frontmatter.citation}
                />
            )
        }
    </article>
</Shell>
