---
import "./md.prelude.scss";
const { frontmatter } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <title>{frontmatter.title}</title>
        <meta name="author" content={frontmatter.author ?? "Skye De La Ciel"} />
        <meta name="description" content={frontmatter.abstract} />
    </head>
    <body>
        <article>
            <header class="front-matter">
                <div class="title-line">
                    <h1 class="title">{frontmatter.title}</h1>
                    <span class="author"
                        >{frontmatter.author ?? "Skye De La Ciel"}</span
                    >
                </div>
                <p class="abstract">{frontmatter.abstract}</p>
            </header>

            <slot />
        </article>
    </body>
</html>
