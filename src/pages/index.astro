---
import Shell from "~/layouts/prelude/Shell.astro";
import FrontMatter from "~/layouts/prelude/FrontMatter.astro";
import PieceList from "~/components/PieceList.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "~/site";
import { publishedArticles, sectionPages } from "~/content/corpus";
import { sectioned } from "~/content/sections";

/** How many of the latest pieces the home page lists. */
const LATEST = 10;

const latest = sectioned(await publishedArticles(), await sectionPages()).slice(
    0,
    LATEST,
);
---

<Shell title={SITE_NAME} description={SITE_DESCRIPTION} host="site">
    <article class="home">
        <FrontMatter title={SITE_NAME} abstract={SITE_DESCRIPTION} />
        {
            latest.length > 0 && (
                <section class="latest" aria-labelledby="latest">
                    <h2 id="latest">Latest</h2>
                    <PieceList pieces={latest} />
                </section>
            )
        }
    </article>
</Shell>
