---
import PageEntry from "~/components/PageEntry.astro";
import { publishedArticles } from "~/content/corpus";

export async function getStaticPaths() {
    return (await publishedArticles()).map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}
---

<PageEntry entry={Astro.props.entry} />
