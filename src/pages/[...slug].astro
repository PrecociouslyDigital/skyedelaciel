---
import { getCollection, render } from "astro:content";
import Layout from "~/layouts/prelude/md.astro";
import { mdxComponents } from "~/components/mdx";
import { setLinkMeta } from "~/components/links/store";

export async function getStaticPaths() {
    const pages = await getCollection("pages");
    return pages.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const linkMeta = remarkPluginFrontmatter.linkMeta ?? {};

// Populate the module store so <Link> components can look up metadata
setLinkMeta(linkMeta);
---

<Layout
    frontmatter={{
        ...entry.data,
        links: remarkPluginFrontmatter.links,
        linkMeta,
    }}
    headings={headings}
>
    <Content components={mdxComponents} />
</Layout>
