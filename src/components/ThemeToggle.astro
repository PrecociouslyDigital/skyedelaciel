<label class="theme-toggle" aria-label="Toggle color scheme">
    <input type="checkbox" id="theme-toggle" />
    <span class="toggle-icon" aria-hidden="true"></span>
</label>

<script>
    // The server renders the box unchecked; a stored choice is applied here.
    // The pre-paint script in Shell.astro has already applied it to the page,
    // through an attribute that the checkbox now takes over from.
    const toggle = document.querySelector<HTMLInputElement>("#theme-toggle")!;

    delete document.documentElement.dataset.themeChecked;
    toggle.checked = JSON.parse(
        localStorage.getItem("theme-override") ?? "false",
    );
    toggle.addEventListener("change", () => {
        localStorage.setItem("theme-override", JSON.stringify(toggle.checked));
    });
</script>

<style lang="scss">
    @use "../layouts/prelude/breakpoints";
    @use "../layouts/prelude/motion";

    $icon: 1.25rem;
    $sidebar-icon: 1.5rem;
    $fingertip: 2.75rem;

    /* Drawn small, but it answers a fingertip all round it. */
    .theme-toggle {
        position: relative;
        cursor: pointer;
        display: flex;
        align-items: center;
        flex: none;
        margin-right: min(0.5rem, 1cqi);

        &::before {
            content: "";
            position: absolute;
            inset: ($icon - $fingertip) * 0.5;
        }
    }

    input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    /* A square rather than a disc: the seal, the frame and the manuscript grid
       are all boxes, and this is the smallest of them. */
    .toggle-icon {
        @include motion.snap(transform);
        box-sizing: border-box;
        width: $icon;
        height: $icon;
        border-radius: 2px;
        border: 1.5px solid var(--color-text);
        background: linear-gradient(
            135deg,
            var(--color-text) 50%,
            transparent 50%
        );
    }

    input:checked + .toggle-icon {
        transform: rotate(180deg);
    }

    input:focus-visible + .toggle-icon {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    @include breakpoints.wide-sidebar {
        .theme-toggle {
            margin-right: 0;
            margin-top: 1rem;
        }

        .toggle-icon {
            width: $sidebar-icon;
            height: $sidebar-icon;
        }
    }
</style>
