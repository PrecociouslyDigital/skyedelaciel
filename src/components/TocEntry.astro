---
import type { TocLevel } from "./toc";

/**
 * One entry of a table of contents, with its section's own TocList, if it has
 * one, as the slot.
 *
 * Only the top level folds: a top-level entry's section is folded under a
 * disclosure beside its link, and grows a vine of its own when it unfolds.
 * Below that, an entry's section is always shown with it.
 *
 */
type Props = {
    href: string;
    text: string;
    /**
     * An entry's place in what it arrives with, which is when it arrives: a
     * top-level entry's among the top level, as the whole list drops open on
     * a narrow page, and any other's in its top-level section, as that grows.
     *
     * Entries filled in when the page is served, as Tumblr fills in a post's
     * tags, have no place at build time. Mark these `counted`: the stylesheet
     * takes each one's place from its siblings, and its section's length from
     * how many there are.
     */
    index: number | "counted";
} & (
    | {
          depth: 1;
          /**
           * How many entries its section unfolds, where that is known when
           * the site is built, so that its vine can be drawn to their length.
           */
          entries?: number;
      }
    | { depth: Exclude<TocLevel, 1>; entries?: never }
);

const { href, text, depth, entries, index } = Astro.props;
---

<li
    data-depth={depth}
    data-entries={entries}
    data-counted={index === "counted" ? "" : undefined}
    style={index === "counted" ? undefined : `--i: ${index}`}
>
    <a href={href}>{text}</a>
    {
        Astro.slots.has("default") &&
            (depth === 1 ? (
                <details>
                    <summary aria-label="Expand section" />
                    <slot />
                </details>
            ) : (
                <slot />
            ))
    }
</li>
