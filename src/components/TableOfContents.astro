---
import { match, P } from "ts-pattern";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface TocNode {
    slug: string;
    text: string;
    children: TocNode[];
}

/** A section of the tree that is still open for children. */
interface Frame {
    depth: number;
    children: TocNode[];
}

/**
 * Exactly one of these: the root call passes the page's flat heading list,
 * the <Astro.self> recursion below passes an already-built subtree.
 */
type Props =
    | { headings: Heading[]; nodes?: never }
    | { nodes: TocNode[]; headings?: never };

/** Build nested tree from flat heading list */
function buildTree(headings: Heading[]): TocNode[] {
    const root: Frame = { depth: 0, children: [] };
    /** Sections still open for children, outermost first. */
    let open: Frame[] = [root];

    for (const { depth, slug, text } of headings) {
        const node: TocNode = { slug, text, children: [] };

        // Only a shallower section can still be this heading's ancestor
        open = open.filter((frame) => frame.depth < depth);
        (open.at(-1) ?? root).children.push(node);
        open.push({ depth, children: node.children });
    }

    return root.children;
}

const nodes = match(Astro.props)
    .with({ headings: P.nonNullable }, ({ headings }) =>
        buildTree(headings.filter((h) => h.depth <= 3)),
    )
    .with({ nodes: P.nonNullable }, ({ nodes }) => nodes)
    .exhaustive();
---

{
    nodes.length > 0 && (
        <ol class="toc-list">
            {nodes.map((node) => (
                <li>
                    <a href={`#${node.slug}`}>{node.text}</a>
                    {node.children.length > 0 && (
                        <details data-slug={node.slug}>
                            <summary aria-label="Expand section" />
                            <Astro.self nodes={node.children} />
                        </details>
                    )}
                </li>
            ))}
        </ol>
    )
}

<style lang="scss">
    .toc-list {
        font-family: sans-serif;
        font-size: 0.85rem;
        list-style: none;
        padding-left: 0;
        margin: 0;

        .toc-list {
            padding-left: 1ch;
            border-left: 1px solid var(--color-muted);
            margin-left: 0.5ch;
        }

        a {
            text-decoration: none;
            color: var(--color-muted);

            &:hover {
                text-decoration: underline;
            }

            &[data-current] {
                color: var(--color-fg);
                // Use a text shadow here to avoid shifting the vertical bar
                text-shadow: 0px 0px 1px black;
            }
        }

        li {
            display: grid;
            grid-template-columns: 1fr 1em;
            grid-template-rows: auto auto;

            // Link in first column
            > a {
                grid-column: 1;
                grid-row: 1;
            }

            > details {
                display: contents;

                // Chevron to the right of link
                > summary {
                    grid-column: 2;
                    grid-row: 1;
                    cursor: pointer;
                    list-style: none;
                    padding-left: 0.5ch;

                    &::marker,
                    &::-webkit-details-marker {
                        display: none;
                    }

                    &::before {
                        content: "▸";
                        transition: transform 0.15s ease;
                        display: inline-block;
                    }
                }

                &[open] > summary::before {
                    transform: rotate(90deg);
                }

                > .toc-list {
                    grid-column: 1 / -1;
                    grid-row: 2;
                    margin-top: 0.25em;
                }
            }
        }
    }

    @media print {
        details {
            // Expand all for print
            &:not([open]) {
                > .toc-list {
                    display: block;
                }
            }
        }
    }
</style>
