---
import { match, P } from "ts-pattern";
import TocEntry from "./TocEntry.astro";
import TocList from "./TocList.astro";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface TocNode {
    slug: string;
    text: string;
    children: TocNode[];
}

/** A section of the tree that is still open for children. */
interface Frame {
    depth: number;
    children: TocNode[];
}

/**
 * Exactly one of these: the root call passes the page's flat heading list,
 * the <Astro.self> recursion below passes an already-built subtree, how deep
 * it sits, and the place its first node takes in its top-level section.
 */
type Props =
    | { headings: Heading[]; nodes?: never; depth?: never; first?: never }
    | { nodes: TocNode[]; depth: number; first: number; headings?: never };

/** Build nested tree from flat heading list */
function buildTree(headings: Heading[]): TocNode[] {
    const root: Frame = { depth: 0, children: [] };
    /** Sections still open for children, outermost first. */
    let open: Frame[] = [root];

    for (const { depth, slug, text } of headings) {
        const node: TocNode = { slug, text, children: [] };

        // Only a shallower section can still be this heading's ancestor
        open = open.filter((frame) => frame.depth < depth);
        (open.at(-1) ?? root).children.push(node);
        open.push({ depth, children: node.children });
    }

    return root.children;
}

/** How many entries a node unfolds, at every level below it. */
const size = (node: TocNode): number =>
    node.children.reduce((total, child) => total + 1 + size(child), 0);

const { nodes, depth, first } = match(Astro.props)
    .with({ headings: P.nonNullable }, ({ headings }) => ({
        nodes: buildTree(headings.filter((h) => h.depth <= 3)),
        depth: 1,
        first: 0,
    }))
    .with({ nodes: P.nonNullable }, (props) => props)
    .exhaustive();

/** Each node, with its place in its top-level section, in document order. */
const placed = nodes.map((node, k) => ({
    node,
    index:
        first +
        nodes.slice(0, k).reduce((at, prior) => at + 1 + size(prior), 0),
}));
---

{
    nodes.length > 0 && (
        <TocList depth={depth}>
            {placed.map(({ node, index }, k) => {
                const entry = {
                    href: `#${node.slug}`,
                    text: node.text,
                    depth,
                    ...(depth === 1
                        ? { entries: size(node), index: k }
                        : { index }),
                };
                return node.children.length > 0 ? (
                    <TocEntry {...entry}>
                        <Astro.self
                            nodes={node.children}
                            depth={depth + 1}
                            first={depth === 1 ? 0 : index + 1}
                        />
                    </TocEntry>
                ) : (
                    <TocEntry {...entry} />
                );
            })}
        </TocList>
    )
}
