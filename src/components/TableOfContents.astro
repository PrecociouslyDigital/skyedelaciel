---
import { match, P } from "ts-pattern";
import TocEntry from "./TocEntry.astro";
import TocList from "./TocList.astro";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface TocNode {
    slug: string;
    text: string;
    children: TocNode[];
}

/** A section of the tree that is still open for children. */
interface Frame {
    depth: number;
    children: TocNode[];
}

/**
 * Exactly one of these: the root call passes the page's flat heading list,
 * the <Astro.self> recursion below passes an already-built subtree.
 */
type Props =
    | { headings: Heading[]; nodes?: never }
    | { nodes: TocNode[]; headings?: never };

/** Build nested tree from flat heading list */
function buildTree(headings: Heading[]): TocNode[] {
    const root: Frame = { depth: 0, children: [] };
    /** Sections still open for children, outermost first. */
    let open: Frame[] = [root];

    for (const { depth, slug, text } of headings) {
        const node: TocNode = { slug, text, children: [] };

        // Only a shallower section can still be this heading's ancestor
        open = open.filter((frame) => frame.depth < depth);
        (open.at(-1) ?? root).children.push(node);
        open.push({ depth, children: node.children });
    }

    return root.children;
}

const { nodes, root } = match(Astro.props)
    .with({ headings: P.nonNullable }, ({ headings }) => ({
        nodes: buildTree(headings.filter((h) => h.depth <= 3)),
        root: true,
    }))
    .with({ nodes: P.nonNullable }, ({ nodes }) => ({ nodes, root: false }))
    .exhaustive();
---

{
    nodes.length > 0 && (
        <TocList root={root}>
            {nodes.map((node) =>
                node.children.length > 0 ? (
                    <TocEntry href={`#${node.slug}`} text={node.text}>
                        <Astro.self nodes={node.children} />
                    </TocEntry>
                ) : (
                    <TocEntry href={`#${node.slug}`} text={node.text} />
                ),
            )}
        </TocList>
    )
}
