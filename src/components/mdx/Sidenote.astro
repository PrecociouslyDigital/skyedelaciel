---
import type { Written } from "./written";
/**
 * CSS-only sidenote. Renders footnote content in the right margin when the
 * viewport is wide enough, or as a toggle-able inline note otherwise.
 *
 * Numbering is entirely CSS-counter-driven — the `id` prop is a slug, not a
 * number, so manually authored <Sidenote> components won't break numbering.
 */
type Props = Written["Sidenote"];

const { id } = Astro.props;
const inputId = `sn-${id}`;

/* doc-noteref is DPub-ARIA. Astro's AriaRole union covers WAI-ARIA 1.2 only
   and is a plain alias, so it can't be augmented — spread it in instead. */
const noterefRole: Record<string, string> = { role: "doc-noteref" };
---

<span class="sidenote-wrapper">
    <input type="checkbox" id={inputId} />
    <label for={inputId} {...noterefRole}></label>
    <small role="note">
        <label for={inputId}></label>
        <slot />
    </small>
</span>

<style lang="scss">
    @use "../../layouts/prelude/breakpoints";
    @use "../../layouts/prelude/layout";
    @use "../../layouts/prelude/ornaments";

    /// A stroke of the brush down a note's left edge, in `$ink`, holding
    /// its column.
    @mixin held($ink) {
        position: relative;
        @include ornaments.brushed-edge($ink, 4px);
    }

    /**
     * 旁批: commentary set outside the frame, in lighter ink, with a light
     * stroke holding the column. Written once because the margin is where a note
     * lives on a wide screen and on paper alike, and paper is narrower than
     * the wide breakpoint.
     */
    @mixin in-the-margin($size) {
        display: block;
        float: right;
        clear: right;
        box-sizing: border-box;
        /* Size to the right gutter, set by prelude.scss */
        width: var(--sidenote-width, #{layout.$sidenote-width});
        /* How far past the text column a note has to begin to clear
           everything drawn on the article's edge: the frame, the corner ticks
           that reach outside it, and a gap past those. All three lengths are
           set by prelude.scss. */
        --standoff: calc(
            -1 * (var(--frame-inset) + var(--tick-reach) + var(--margin-gap))
        );
        margin-right: calc(
            var(--standoff) - var(--sidenote-width, #{layout.$sidenote-width})
        );
        margin-bottom: 0.5rem;
        padding: 0 0 0 1ch;
        font-size: $size;
        @include held(var(--color-border));

        /* Label is not interactive out here, just a number */
        > label {
            cursor: default;
        }
    }

    .sidenote-wrapper {
        /* Inline context for the marker; block for the note is handled per mode */
        display: inline;
    }

    input[type="checkbox"] {
        display: none;
    }

    /* — The note's number: its marker in the text, and its dismissal in the
       note itself on a narrow page. — */
    label[role="doc-noteref"],
    small[role="note"] > label {
        cursor: pointer;
        vertical-align: super;
        line-height: 0;
        font-weight: 600;
        color: var(--color-accent);
    }

    label[role="doc-noteref"] {
        font-size: 0.72em;
        counter-increment: sidenote;

        &::after {
            content: counter(sidenote);
        }
    }

    /* — Note body — */
    small[role="note"] {
        display: none;
        font-size: 0.82rem;
        line-height: 1.45;
        color: var(--color-muted);

        /* Dismiss label (narrow viewports only) */
        > label {
            font-size: 0.75em;
            margin-right: 0.35em;

            &::after {
                content: counter(sidenote) ".";
            }
        }
    }

    /* — Narrow: toggle on checkbox — */
    .sidenote-wrapper:has(input:checked) > small[role="note"] {
        display: block;
        margin: 0.5rem 0;
        padding-left: 1rem;
        @include held(var(--color-accent));
    }

    /* — Wide: always visible in right margin — */
    @include breakpoints.wide {
        small[role="note"],
        /* Out here the narrow toggle must not change the layout. */
        .sidenote-wrapper:has(input:checked) > small[role="note"] {
            @include in-the-margin(0.82rem);
        }

        /* Bring a note up to full ink while its marker is hovered. */
        .sidenote-wrapper:has(label[role="doc-noteref"]:hover) > small {
            color: var(--color-text);

            &::before {
                background-color: var(--color-accent);
            }
        }
    }

    /* — Print: the margin again, on a sheet narrower than the wide tier — */
    @media print {
        small[role="note"] {
            @include in-the-margin(0.78rem);
        }
    }
</style>
