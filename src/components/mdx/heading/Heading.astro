---
import type { HTMLTag } from "astro/types";
import CopyAnchorIcon from "./CopyAnchorIcon.svelte";

export interface Props {
    /** e.g. "h1", "h2", ... */
    as: HTMLTag;
    id?: string;
    [key: string]: any;
}

const { as: Tag, id, ...rest } = Astro.props;
---

<Tag id={id} class="heading" {...rest}
    ><a href={id ? `#${id}` : undefined} class="heading-anchor"><slot /></a>{
        id && <CopyAnchorIcon slug={id} client:visible />
    }</Tag
>

<style lang="scss">
    /* The type scale itself lives in prelude.scss, where the bibliography's
       own <h2> and the front matter's <h1> can reach it too. */
    .heading:hover :global(.copy-anchor) {
        opacity: 1;
    }

    .heading-anchor {
        text-decoration-line: none;

        // Longhand, so the underline keeps the accent colour prelude.scss
        // gives every link rather than resetting to `currentColor`.
        &:hover {
            text-decoration-line: underline;
            text-decoration-thickness: 2px;
        }
    }
</style>
