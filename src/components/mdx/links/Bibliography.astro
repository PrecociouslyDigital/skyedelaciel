---
import { formatCitation, isCitable } from "./cite";
import type { LinkMeta, CslData } from "./types";

interface Props {
    linkMeta: LinkMeta;
    citations?: CslData[];
}

const { linkMeta, citations = [] } = Astro.props;

// Every outbound link, plus any citations added by hand in the frontmatter
const cited = Object.values(linkMeta)
    .filter(isCitable)
    .map((entry) => entry.csl)
    .concat(citations);

const entries = cited
    .map((csl) => ({ csl, formatted: formatCitation(csl) }))
    .sort((a, b) => a.formatted.localeCompare(b.formatted));
---

{
    entries.length > 0 && (
        <section class="bibliography" aria-label="Works referenced">
            <h2>Works Referenced</h2>
            <ol>
                {/* An entry with no URL has nothing to link to — an <a> with no
                    href still gets announced as a link by screen readers — so
                    it renders as plain text instead. */}
                {entries.map(({ csl, formatted }) => (
                    <li>
                        {csl.URL ? (
                            <a
                                href={csl.URL}
                                class="content-link"
                                set:html={formatted}
                            />
                        ) : (
                            <span set:html={formatted} />
                        )}
                    </li>
                ))}
            </ol>
        </section>
    )
}

<style lang="scss">
    /* .cite-url lives inside set:html content, so needs :global scoped
       under .bibliography to avoid leaking */
    .bibliography :global(.cite-url) {
        display: none;
    }

    @media print {
        .bibliography :global(.cite-url) {
            display: inline;
        }
    }
</style>
