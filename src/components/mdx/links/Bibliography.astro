---
import { formatCitation } from "./cite";
import type { LinkEntry, CslData } from "./types";

interface Props {
    linkMeta: Record<string, LinkEntry>;
    citations?: CslData[];
}

const { linkMeta, citations = [] } = Astro.props;

// Merge resolved link entries and manually added citations
const fromLinks = Object.values(linkMeta)
    .filter((e) => e.kind !== "internal")
    .map((e) => ({ csl: e.csl, formatted: formatCitation(e) }));

const fromCitations = citations.map((csl) => ({
    csl,
    formatted: formatCitation({ csl, kind: "external" }),
}));

const entries = [...fromLinks, ...fromCitations].sort((a, b) =>
    a.formatted.localeCompare(b.formatted),
);
---

{
    entries.length > 0 && (
        <section class="bibliography" aria-label="Works referenced">
            <h2>Works Referenced</h2>
            <ol>
                {entries.map(({ csl, formatted }) => (
                    <li>
                        <a href={csl.URL} class="content-link" set:html={formatted}/>
                    </li>
                ))}
            </ol>
        </section>
    )
}

<style lang="scss">
    /* .cite-url lives inside set:html content, so needs :global scoped
       under .bibliography to avoid leaking */
    .bibliography :global(.cite-url) {
        display: none;
    }

    @media print {
        .bibliography :global(.cite-url) {
            display: inline;
        }
    }
</style>
