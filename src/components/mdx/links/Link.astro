---
import { getLinkMeta } from "./store";
import type { CslDate, LinkEntry } from "./types";

const { href, showImage = false, ...rest } = Astro.props;
const entry = href ? getLinkMeta(href) : undefined;

/** Format CSL date-parts into a human-readable string. */
const formatCslDate = (date: CslDate | undefined): string | undefined => {
    const parts = date?.["date-parts"]?.[0];
    if (!parts?.length) return date?.literal ?? date?.raw;
    const [year, month, day] = parts.map(Number);
    // Build date from available granularity
    if (month && day)
        return new Date(year, month - 1, day).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
        });
    if (month)
        return new Date(year, month - 1).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
        });
    return String(year);
};

/** Format a CSL author name object into a display string. */
const formatAuthor = (
    a: { given?: string; family?: string; literal?: string } | undefined,
): string | undefined =>
    a?.literal ??
    (a?.given && a?.family ? `${a.given} ${a.family}` : a?.family);

/** Comma-separated author list. */
const authorLine = (entry: LinkEntry): string | undefined => {
    const authors = entry.csl.author;
    if (!authors?.length) return undefined;
    return authors.map(formatAuthor).filter(Boolean).join(", ");
};

const { csl } = entry ?? {};

/** Whether we have enough metadata to show a popover. */
const hasPopover = entry && (csl?.title || entry.summary || csl?.abstract);

/** Source label by kind. */
const siteName =
    entry?.kind === "internal"
        ? "skyedelaciel"
        : entry?.kind === "wikipedia"
          ? "Wikipedia"
          : (csl?.["container-title"] ?? undefined);

/** Pick the best descriptive text. */
const description = entry?.summary ?? csl?.abstract ?? undefined;
---

{
    hasPopover ? (
        <span class="link-wrapper">
            <a href={href} {...rest} class:list={["content-link", rest.class]}>
                <slot />
            </a>
            <span class="link-popover" role="tooltip">
                {showImage && entry.imageUrl && (
                    <img
                        class="link-popover-image"
                        src={entry.imageUrl}
                        alt=""
                        loading="lazy"
                    />
                )}
                {csl?.title && (
                    <span class="link-popover-title">{csl.title}</span>
                )}
                {authorLine(entry) && (
                    <span class="link-popover-meta">{authorLine(entry)}</span>
                )}
                {siteName && (
                    <span class="link-popover-meta link-popover-site">
                        {siteName}
                    </span>
                )}
                {entry.kind === "doi" && csl?.["container-title"] && (
                    <span class="link-popover-meta link-popover-journal">
                        {csl["container-title"]}
                    </span>
                )}
                {csl?.issued && (
                    <span class="link-popover-meta">
                        {formatCslDate(csl.issued)}
                    </span>
                )}
                {csl?.accessed && (
                    <span class="link-popover-meta link-popover-retrieved">
                        Retrieved {formatCslDate(csl.accessed)}
                    </span>
                )}
                {description && (
                    <span class="link-popover-description">{description}</span>
                )}
            </span>
        </span>
    ) : (
        <a href={href} {...rest} class:list={["content-link", rest.class]}>
            <slot />
        </a>
    )
}

<style lang="scss">
    .link-wrapper {
        position: relative;
        display: inline;
    }

    .link-popover {
        display: none;
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        width: 22rem;
        max-height: 16rem;
        overflow-y: auto;
        padding: 0.6rem 0.75rem;
        margin-bottom: 0.35rem;
        background: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        font-size: 0.82rem;
        line-height: 1.4;
        font-weight: normal;

        /* Stack children vertically */
        & > :global(*) {
            display: block;
        }
    }

    .link-wrapper:hover .link-popover,
    .link-wrapper:focus-within .link-popover {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .link-popover-image {
        max-width: 100%;
        max-height: 6rem;
        object-fit: cover;
        border-radius: 2px;
    }

    .link-popover-title {
        font-weight: 600;
    }

    .link-popover-meta {
        color: var(--color-muted);
        font-size: 0.78rem;
    }

    .link-popover-journal {
        font-style: italic;
    }

    .link-popover-description {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @media print {
        .link-popover {
            display: none !important;
        }
    }
</style>
