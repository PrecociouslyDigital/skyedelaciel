---
import { formatInlineCitation } from "./cite";
import { geometryStyle } from "./geometry";
import { placeImage } from "./image";
import { isCitable, isResolved, sourceFor } from "./sources";
import { getLinkMeta, hasBibliography } from "./store";
import { buildPreview } from "./preview";

export interface Props {
    href: string;
    [key: string]: any;
}

const { href, ...rest } = Astro.props;

const entry = getLinkMeta(href);
const preview = entry && buildPreview(entry);
const image =
    preview?.image === undefined ? undefined : await placeImage(preview.image);

/** The pane's measurements, and a column image's, which the pane is built around. */
const paneStyle = {
    ...geometryStyle,
    ...(image?.placement === "column" && {
        "--image-width": `${image.drawn.width}px`,
        "--image-height": `${image.drawn.height}px`,
    }),
};

/**
 * Printed pages can't be clicked, so this is what appears in the link's
 * place: the "(Author, Year)" citation when the target is in the
 * bibliography, otherwise its raw address.
 */
const inBibliography = hasBibliography() && entry && isCitable(entry);
const citation =
    (inBibliography && formatInlineCitation(entry.csl)) || `(${href})`;

/**
 * Where the link leads, and whether anything was found there. Both are facts
 * the machine layer draws — see fixtures/design.mdx, Annotation — and they are
 * independent: the glyph says which kind of address this is, its colour says
 * whether the address answered.
 */
const { mark } = sourceFor(href);
const resolved = isResolved(href, entry);
---

<span class="link-wrapper">
    <a href={href} {...rest} class:list={["content-link", rest.class]}>
        <slot /><span
            class:list={["link-mark", !resolved && "unresolved"]}
            aria-hidden="true">{mark}</span
        >
    </a>
    <span class="link-cite"> {citation}</span>
    {
        preview && (
            <span class="link-popover-anchor">
                <span
                    class="link-popover"
                    role="tooltip"
                    data-image={image?.placement}
                    style={paneStyle}
                >
                    <span class="link-popover-text">
                        <span class="link-popover-title">
                            <span>{preview.title}</span>
                        </span>
                        {preview.meta.length > 0 && (
                            <span class="link-popover-meta">
                                <span>{preview.meta.join(" · ")}</span>
                            </span>
                        )}
                        {preview.body && (
                            <span class="link-popover-description">
                                {preview.body.type === "html" ? (
                                    <span set:html={preview.body.content} />
                                ) : (
                                    <span set:text={preview.body.content} />
                                )}
                            </span>
                        )}
                        {preview.fields.length > 0 && (
                            <span class="link-popover-ledger" role="table">
                                <span class="link-popover-rows" role="rowgroup">
                                    {preview.fields.map(({ label, value }) => (
                                        <span
                                            class="link-popover-row"
                                            role="row"
                                        >
                                            <span
                                                class="link-popover-key"
                                                role="rowheader"
                                            >
                                                {label}
                                            </span>
                                            <span
                                                role="cell"
                                                set:html={value}
                                            />
                                        </span>
                                    ))}
                                </span>
                            </span>
                        )}
                    </span>
                    {image && (
                        <span class="link-popover-figure">
                            <span class="link-popover-picture">
                                <img
                                    class="link-popover-image"
                                    src={image.src}
                                    width={image.width}
                                    height={image.height}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                />
                            </span>
                        </span>
                    )}
                </span>
            </span>
        )
    }
</span>

<style lang="scss">
    @use "../../../layouts/prelude/motion";
    @use "../../../layouts/prelude/ornaments";
    @use "../../../layouts/prelude/resolve";
    @use "../../../layouts/prelude/typography";

    /* How long a pointer must rest on the link before the popover answers,
       how long the glass then takes to fade in, and how long each part of what
       is on it takes to resolve and to unresolve, a beat after the part above
       it. Arriving, the last part is done about 300ms after the first began. */
    $standoff: 0.3s;
    $fade: 120ms;
    $resolve: 180ms;
    $resolve-beat: 35ms;
    $unresolve: 120ms;
    $unresolve-beat: 15ms;

    /* The parts of the text: its title, meta, summary and ledger. One past
       the last would resolve with the last. The image is a part too, and
       resolves with the first. */
    $parts: 4;

    /* Leaving, the glass fades out as the last part unresolves, rather than
       taking the parts below with it before they have had their turn. */
    $lag: ($parts - 1) * $unresolve-beat;

    /* How far a popover keeps from the edge of the screen. */
    $edge: 1rem;

    /* The link is what the popover is anchored to. The name is scoped to the
       wrapper, so each popover finds its own link rather than the page's last. */
    .link-wrapper {
        position: relative;
        display: inline;
        anchor-scope: --link;
    }

    .content-link {
        anchor-name: --link;
    }

    /* Screens have the link itself; only paper needs it spelled out. */
    .link-cite {
        display: none;
    }

    /* The machine's note on where this goes, set inside the anchor so it
       travels with the link and is underlined along with it. In `signal` while
       the address answered; in `attention` when it did not, which leaves both facts
       legible at once rather than spending a second glyph on the second one. */
    .link-mark {
        margin-left: 0.12em;
        font-weight: 400;
        font-size: 0.68em;
        vertical-align: 0.42em;
        letter-spacing: 0.04em;
        color: var(--color-signal);

        &.unresolved {
            color: var(--color-attention);
        }
    }

    /* The popover stands half a line clear of its link, and that standoff is
       padding here rather than margin on the paper: a gap the pointer can be
       over is a gap it can cross, so the popover no longer closes under a
       mouse on its way up to it. */
    .link-popover-anchor {
        position: absolute;
        bottom: 100%;
        padding-bottom: 0.5lh;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;

        /* Centred over its link, unless that would carry it past the edge of
           the screen: placed by area against the viewport, a box that
           overflows is pushed back inside, and its margin keeps it a gutter
           clear of the edge. A browser that cannot anchor centres it over
           the wrapper, as above, edges or not. */
        @supports (position-area: top) {
            position: fixed;
            position-anchor: --link;
            position-area: top;
            inset: auto;
            margin-inline: $edge;
            transform: none;
        }

        /* The delay is the standoff in time that the padding above is in
           space: long enough that a pointer crossing a link on its way
           somewhere else never summons one.

           The anchor's half of the entrance is `visibility`, and only
           that. Because the box stays rendered, the pane inside it always
           has an opacity to fade from, with no `@starting-style` needed
           to find one. And because `visibility: hidden` also removes a
           subtree from the accessible tree, from find-in-page and from
           hit testing, the popover stays fully hidden while it is down,
           standoff padding included.

           The fade itself is on the pane rather than here, and has to be:
           an ancestor carrying a composited opacity is a backdrop root,
           and a backdrop root above the pane leaves its `backdrop-filter`
           with nothing behind it to blur. */
        @include motion.snap(visibility, $fade, $standoff + $lag);
        visibility: hidden;
    }

    /* Hovering the popover is hovering the wrapper it hangs from, so holding
       the link open and holding the popover open are the same rule. */
    .link-wrapper:hover,
    .link-wrapper:focus-within {
        .link-popover-anchor {
            @include motion.snap(visibility, $fade, $standoff);
            visibility: visible;
        }

        .link-popover {
            @include motion.snap((opacity, translate), $fade, $standoff);
            opacity: 1;
            translate: 0 0;
        }

        .link-popover-picture {
            @include motion.snap(content-visibility, $fade, $standoff);
            content-visibility: visible;
        }

        .link-popover-text > *,
        .link-popover-figure {
            @include resolve.part-played(
                $resolve,
                calc(#{$standoff} + var(--part, 0) * #{$resolve-beat})
            );
        }
    }

    /* A pane of the machine's glass held over the page, since what is on it is
       the machine's reading of the address rather than anything the author
       wrote. It is laid out as a page preview: the text, and beside or above
       it an image, which `placeImage` has already put in whichever box suits
       its shape. Only the text scrolls. A column image holds still beside it,
       and a banner gives way above it, on the text's scroll timeline. */
    .link-popover {
        timeline-scope: --link-popover-text;

        @include ornaments.glass;

        /* The pane rises the last few pixels into place as it takes colour,
           and sinks back as it loses it, in step with the anchor above. */
        @include motion.snap((opacity, translate), $fade, $standoff + $lag);
        opacity: 0;
        translate: 0 0.35rem;

        /* A flexible row under a capped height shrinks to fit the cap, and
           the text in it scrolls. Longhands, because each placement below
           changes only the ones it needs to. */
        display: grid;
        /* stylelint-disable-next-line declaration-block-no-redundant-longhand-properties */
        grid-template-areas: "text";
        grid-template-rows: minmax(0, 1fr);
        grid-template-columns: minmax(0, 1fr);
        width: min(var(--pane-width), 100vw - #{2 * $edge});
        max-height: var(--max-height);
        color: var(--color-text);
        font-size: var(--text-small);
        line-height: 1.45;
        font-weight: normal;

        /* Built around the image: the column is as wide as it is drawn, and
           the pane as tall, each with the glass's inset, so the image runs
           whole from the top of the glass to the bottom. */
        &[data-image="column"] {
            grid-template-areas: "text image";
            grid-template-columns:
                minmax(0, 1fr)
                calc(var(--image-width) + #{ornaments.$glass-gap});
            height: calc(var(--image-height) + #{2 * ornaments.$glass-gap});
        }

        &[data-image="banner"] {
            grid-template-areas: "image" "text";
            grid-template-rows: auto minmax(0, 1fr);
            max-height: var(--bannered-max-height);
        }
    }

    .link-popover-text {
        grid-area: text;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        overflow-y: auto;
        scroll-timeline: --link-popover-text block;
        scrollbar-width: thin;
        // Clear of the glass's edge, which stands $glass-gap in from the ticks.
        padding: 1.1rem 1.2rem;

        [data-image="column"] > & {
            padding-right: 1rem;
        }

        [data-image="banner"] > & {
            padding-top: 0.8rem;
        }
    }

    /* What is on the glass resolves part by part, as pictures load: each part
       of the text, and the image, is a frame for the blocks to be laid over
       and a picture inside it to come into focus. They come in from the top,
       a beat apart, and go from the top too, so that leaving is not arriving
       played backwards; see _resolve.scss. */
    .link-popover-text > *,
    .link-popover-figure {
        @include resolve.part;
        @include resolve.part-played(
            $unresolve,
            calc(#{$standoff} + var(--part, 0) * #{$unresolve-beat}),
            $leaving: true
        );
    }

    @for $n from 2 through $parts {
        $nth: $n;
        @if $n == $parts {
            $nth: "n + #{$n}";
        }

        .link-popover-text > :nth-child(#{$nth}) {
            --part: #{$n - 1};
        }
    }

    /* Inset by the glass's own gap, so the image runs to the edge of the
       glass and stops where it does, clear of the ticks. */
    .link-popover-figure {
        grid-area: image;
        min-width: 0;
        min-height: 0;

        [data-image="column"] > & {
            place-self: start end;
            margin: ornaments.$glass-gap ornaments.$glass-gap
                ornaments.$glass-gap 0;
        }

        /* As the text scrolls up, the banner gives way to it, partly: it
           moves exactly as far as the reader scrolls, and only for the first
           stretch of it. Under reduced motion it stays put, because this is
           motion set off by scrolling. It is the frame that gives way, since
           the image inside it has resolving of its own to do.

           A browser without scroll timelines would play this as an ordinary
           animation of no length, and hold its end: a banner already shrunk
           before anything was scrolled. */
        [data-image="banner"] > & {
            place-self: stretch;
            margin: ornaments.$glass-gap ornaments.$glass-gap 0;
            height: var(--banner-height);

            @media (prefers-reduced-motion: no-preference) {
                @supports (animation-timeline: scroll()) {
                    animation: link-popover-banner-gives-way linear both;
                    animation-timeline: --link-popover-text;
                    animation-range: 0
                        calc(var(--banner-height) - var(--banner-min-height));
                }
            }
        }
    }

    /* What holds the image back until the popover opens. `visibility` alone
       still lays an image out, and a lazy image that is laid out is fetched
       with the page rather than on hover, so the holder's contents are
       skipped while the popover is down. It flips with the same timing as
       `visibility`, so the fade survives it.

       Only the image is skipped. Skipped contents have no style, so anything
       in them with a standoff to wait out would only start waiting once
       revealed, a standoff after the glass. Being skipped, the image sizes
       nothing either, so the holder takes its size from the pane. */
    .link-popover-picture {
        display: block;
        @include motion.snap(content-visibility, $fade, $standoff + $lag);
        transition-behavior: allow-discrete;
        content-visibility: hidden;

        [data-image="column"] & {
            width: var(--image-width);
            height: var(--image-height);
        }

        [data-image="banner"] & {
            height: 100%;
        }
    }

    .link-popover-image {
        display: block;

        /* Shown whole, at the size `placeImage` drew it at, which has the
           image's own proportions. Being given rather than measured, it sizes
           the pane before the image has loaded. */
        [data-image="column"] & {
            width: var(--image-width);
            height: var(--image-height);
        }

        /* Cropped to fill its frame, which runs the pane's width. */
        [data-image="banner"] & {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    @keyframes link-popover-banner-gives-way {
        to {
            height: var(--banner-min-height);
        }
    }

    .link-popover-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-h4);
        line-height: 1.2;
    }

    .link-popover-meta {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-style: italic;
    }

    /* Justify only works because these descriptions are short (2-3 lines);
       longer text would show whitespace gaps. Hyphens avoid a ragged gap
       on the last line when a word can't break. */
    .link-popover-description {
        text-align: justify;
        hyphens: auto;
    }

    /* The facts below the summary, ruled as the site's tables are: ink over
       the first row, a hairline under each. It is spans with table roles
       rather than a <table>, because a <table> would close the paragraph
       the link sits in. The ruling is on the row group rather than the
       table, so that it is part of the picture that resolves. */
    .link-popover-ledger {
        margin-top: 0.5rem;
    }

    .link-popover-rows {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: 0.8rem;
        border-top: 1.5px solid var(--color-text);
        line-height: 1.35;
        font-variant-numeric: lining-nums tabular-nums;
    }

    .link-popover-row {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        padding-block: 0.25rem;
        border-bottom: 1px solid var(--color-border);
    }

    .link-popover-key {
        @include typography.apparatus(var(--text-small));
        font-weight: 600;
    }

    @media print {
        .link-popover-anchor {
            display: none !important;
        }

        /* A printed link cannot be followed, so saying where it would have
           gone is noise. The citation below says it in words instead. */
        .link-mark {
            display: none;
        }

        .link-cite {
            display: inline;
        }
    }
</style>
