---
import { getLinkMeta } from "./store";
import { authorLine, formatCslDate } from "./cite";
import * as R from "ramda";

export interface Props {
    href: string;
    showImage: boolean;
    [key: string]: any;
}

const { href, showImage = false, ...rest } = Astro.props;

const entry = getLinkMeta(href);
if (entry == null) throw new Error("null href passed to a?");

const { csl } = entry;

/** Whether we have enough metadata to show a popover. */
const hasPopover = entry && (csl?.title || entry.summary || csl?.abstract);

/** Single metadata line: author, site/journal, date — joined by " · " */
const metaParts: string[] = (() => {
    switch (entry.kind) {
        case "external":
        case "doi":
            return [
                authorLine(entry),
                csl?.["container-title"] ?? "",
                formatCslDate(csl.issued),
            ];
        case "wikipedia":
        case "internal":
            return [];
    }
})();
const metaLine = metaParts.map(R.trim).filter(R.isNotEmpty).join(" · ");

/** Pick the best descriptive text. */
const description = entry?.summary ?? csl?.abstract;
---

{
    hasPopover ? (
        <span class="link-wrapper">
            <a href={href} {...rest} class:list={["content-link", rest.class]}>
                <slot />
            </a>
            <span class="link-popover" role="tooltip">
                {showImage && entry.imageUrl && (
                    <img
                        class="link-popover-image"
                        src={entry.imageUrl}
                        alt=""
                        loading="lazy"
                    />
                )}
                {csl?.title && (
                    <span class="link-popover-title">{csl.title}</span>
                )}
                {metaLine && <span class="link-popover-meta">{metaLine}</span>}
                {description && (
                    <span
                        class="link-popover-description"
                        set:html={description}
                    />
                )}
            </span>
        </span>
    ) : (
        <a href={href} {...rest} class:list={["content-link", rest.class]}>
            <slot />
        </a>
    )
}

<style lang="scss">
    .link-wrapper {
        position: relative;
        display: inline;
    }

    .link-popover {
        display: none;
        flex-direction: column;
        gap: 0.25rem;
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        width: 22rem;
        max-height: 16rem;
        overflow-y: scroll;
        padding: 0.6rem 0.75rem;
        background: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        font-size: 0.82rem;
        line-height: 1.4;
        font-weight: normal;

        opacity: 0;
        transition:
            opacity 0.15s ease 0.3s,
            display 0.15s ease 0.4s;
        transition-behavior: allow-discrete;

    }

    .link-wrapper:hover .link-popover,
    .link-wrapper:focus-within .link-popover,
    .link-popover:hover {
        display: flex;
        opacity: 1;
    }

    .link-popover-image {
        max-width: 100%;
        max-height: 6rem;
        object-fit: cover;
        border-radius: 2px;
    }

    .link-popover-title {
        font-weight: 600;
    }

    .link-popover-meta {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-style: italic;
    }

    @media print {
        .link-popover {
            display: none !important;
        }
    }
</style>
