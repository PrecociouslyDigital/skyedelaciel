---
import { formatInlineCitation } from "./cite";
import { geometryStyle } from "./geometry";
import { placeImage } from "./image";
import { isCitable, isResolved, sourceFor } from "./sources";
import { getLinkMeta, hasBibliography } from "./store";
import { buildPreview } from "./preview";

export interface Props {
    href: string;
    [key: string]: any;
}

const { href, ...rest } = Astro.props;

const entry = getLinkMeta(href);
const preview = entry && buildPreview(entry);
const image =
    preview?.image === undefined ? undefined : await placeImage(preview.image);

/** The pane's measurements, and a column image's, which the pane is built around. */
const paneStyle = {
    ...geometryStyle,
    ...(image?.placement === "column" && {
        "--image-width": `${image.drawn.width}px`,
        "--image-height": `${image.drawn.height}px`,
    }),
};

/**
 * Printed pages can't be clicked, so this is what appears in the link's
 * place: the "(Author, Year)" citation when the target is in the
 * bibliography, otherwise its raw address.
 */
const inBibliography = hasBibliography() && entry && isCitable(entry);
const citation =
    (inBibliography && formatInlineCitation(entry.csl)) || `(${href})`;

/**
 * Where the link leads, and whether anything was found there. Both are facts
 * the machine layer draws — see design.mdx, Annotation — and they are
 * independent: the glyph says which kind of address this is, its colour says
 * whether the address answered.
 */
const { mark } = sourceFor(href);
const resolved = isResolved(href, entry);
---

<span class="link-wrapper">
    <a href={href} {...rest} class:list={["content-link", rest.class]}>
        <slot /><span
            class:list={["link-mark", !resolved && "unresolved"]}
            aria-hidden="true">{mark}</span
        >
    </a>
    <span class="link-cite"> {citation}</span>
    {
        preview && (
            <span class="link-popover-anchor">
                <span
                    class="link-popover"
                    role="tooltip"
                    data-image={image?.placement}
                    style={paneStyle}
                >
                    <span class="link-popover-text">
                        <span class="link-popover-title">{preview.title}</span>
                        {preview.meta.length > 0 && (
                            <span class="link-popover-meta">
                                {preview.meta.join(" · ")}
                            </span>
                        )}
                        {preview.body &&
                            (preview.body.type === "html" ? (
                                <span
                                    class="link-popover-description"
                                    set:html={preview.body.content}
                                />
                            ) : (
                                <span
                                    class="link-popover-description"
                                    set:text={preview.body.content}
                                />
                            ))}
                        {preview.fields.length > 0 && (
                            <span class="link-popover-ledger" role="table">
                                {preview.fields.map(({ label, value }) => (
                                    <span class="link-popover-row" role="row">
                                        <span
                                            class="link-popover-key"
                                            role="rowheader"
                                        >
                                            {label}
                                        </span>
                                        <span role="cell" set:html={value} />
                                    </span>
                                ))}
                            </span>
                        )}
                    </span>
                    {image && (
                        <img
                            class="link-popover-image"
                            src={image.src}
                            width={image.width}
                            height={image.height}
                            alt=""
                            loading="lazy"
                            decoding="async"
                        />
                    )}
                </span>
            </span>
        )
    }
</span>

<style lang="scss">
    @use "../../../layouts/prelude/motion";
    @use "../../../layouts/prelude/ornaments";
    @use "../../../layouts/prelude/typography";

    .link-wrapper {
        position: relative;
        display: inline;
    }

    /* Screens have the link itself; only paper needs it spelled out. */
    .link-cite {
        display: none;
    }

    /* The machine's note on where this goes, set inside the anchor so it
       travels with the link and is underlined along with it. In `signal` while
       the address answered; in `attention` when it did not, which leaves both facts
       legible at once rather than spending a second glyph on the second one. */
    .link-mark {
        margin-left: 0.12em;
        font-weight: 400;
        font-size: 0.68em;
        vertical-align: 0.42em;
        letter-spacing: 0.04em;
        color: var(--color-signal);

        &.unresolved {
            color: var(--color-attention);
        }
    }

    /* The popover stands half a line clear of its link, and that standoff is
       padding here rather than margin on the paper: a gap the pointer can be
       over is a gap it can cross, so the popover no longer closes under a
       mouse on its way up to it. */
    .link-popover-anchor {
        position: absolute;
        bottom: 100%;
        padding-bottom: 0.5lh;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;

        /* The delay is the standoff in time that the padding above is in
           space: long enough that a pointer crossing a link on its way
           somewhere else never summons one.

           The anchor's half of the entrance is `visibility`, and only
           that. Because the box stays rendered, the pane inside it always
           has an opacity to fade from, with no `@starting-style` needed
           to find one. And because `visibility: hidden` also removes a
           subtree from the accessible tree, from find-in-page and from
           hit testing, the popover stays fully hidden while it is down,
           standoff padding included.

           The fade itself is on the pane rather than here, and has to be:
           an ancestor carrying a composited opacity is a backdrop root,
           and a backdrop root above the pane leaves its `backdrop-filter`
           with nothing behind it to blur. */
        @include motion.snap(visibility, 120ms, 0.3s);
        visibility: hidden;
    }

    /* Hovering the popover is hovering the wrapper it hangs from, so holding
       the link open and holding the popover open are the same rule. */
    .link-wrapper:hover .link-popover-anchor,
    .link-wrapper:focus-within .link-popover-anchor {
        visibility: visible;
    }

    .link-wrapper:hover .link-popover,
    .link-wrapper:focus-within .link-popover {
        opacity: 1;
        translate: 0 0;
        content-visibility: visible;
    }

    /* A pane of the machine's glass held over the page, since what is on it is
       the machine's reading of the address rather than anything the author
       wrote. It is laid out as a page preview: the text, and beside or above
       it an image, which `placeImage` has already put in whichever box suits
       its shape. Only the text scrolls. A column image holds still beside it,
       and a banner gives way above it, on the text's scroll timeline. */
    .link-popover {
        timeline-scope: --link-popover-text;

        @include ornaments.glass;

        /* The pane rises the last few pixels into place as it takes colour,
           and sinks back as it loses it, on the same standoff the anchor
           above waits out.

           Its contents are skipped while it is down. `visibility` alone
           still lays them out, and a lazy image that is laid out is fetched
           with the page rather than on hover. `content-visibility` flips
           with the same timing as `visibility`, so the fade survives it. */
        @include motion.snap(
            (opacity, translate, content-visibility),
            120ms,
            0.3s
        );
        transition-behavior: allow-discrete;
        opacity: 0;
        translate: 0 0.35rem;
        content-visibility: hidden;

        /* A flexible row under a capped height shrinks to fit the cap, and
           the text in it scrolls. Longhands, because each placement below
           changes only the ones it needs to. */
        display: grid;
        /* stylelint-disable-next-line declaration-block-no-redundant-longhand-properties */
        grid-template-areas: "text";
        grid-template-rows: minmax(0, 1fr);
        grid-template-columns: minmax(0, 1fr);
        width: var(--pane-width);
        max-height: var(--max-height);
        color: var(--color-text);
        font-size: var(--text-small);
        line-height: 1.45;
        font-weight: normal;

        /* Built around the image: the column is as wide as it is drawn, and
           the pane as tall, each with the glass's inset, so the image runs
           whole from the top of the glass to the bottom. */
        &[data-image="column"] {
            grid-template-areas: "text image";
            grid-template-columns:
                minmax(0, 1fr)
                calc(var(--image-width) + #{ornaments.$glass-gap});
            height: calc(var(--image-height) + #{2 * ornaments.$glass-gap});
        }

        &[data-image="banner"] {
            grid-template-areas: "image" "text";
            grid-template-rows: auto minmax(0, 1fr);
            max-height: var(--bannered-max-height);
        }
    }

    .link-popover-text {
        grid-area: text;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        overflow-y: auto;
        scroll-timeline: --link-popover-text block;
        scrollbar-width: thin;
        // Clear of the glass's edge, which stands $glass-gap in from the ticks.
        padding: 1.1rem 1.2rem;

        [data-image="column"] > & {
            padding-right: 1rem;
        }

        [data-image="banner"] > & {
            padding-top: 0.8rem;
        }
    }

    /* Inset by the glass's own gap, so the image runs to the edge of the
       glass and stops where it does, clear of the ticks. */
    .link-popover-image {
        grid-area: image;
        min-width: 0;
        min-height: 0;

        /* Shown whole, at the size `placeImage` drew it at, which has the
           image's own proportions. Being given rather than measured, it sizes
           the pane before the image has loaded. */
        [data-image="column"] > & {
            place-self: start end;
            width: var(--image-width);
            height: var(--image-height);
            margin: ornaments.$glass-gap ornaments.$glass-gap
                ornaments.$glass-gap 0;
        }

        /* Cropped to fill the pane's width. */
        [data-image="banner"] > & {
            place-self: stretch;
            width: auto;
            height: var(--banner-height);
            margin: ornaments.$glass-gap ornaments.$glass-gap 0;
            object-fit: cover;

            /* As the text scrolls up, the banner gives way to it, partly: it
               moves exactly as far as the reader scrolls, and only for the
               first stretch of it. Under reduced motion it stays put,
               because this is motion set off by scrolling.

               A browser without scroll timelines would play this as an
               ordinary animation of no length, and hold its end: a banner
               already shrunk before anything was scrolled. */
            @media (prefers-reduced-motion: no-preference) {
                @supports (animation-timeline: scroll()) {
                    animation: link-popover-banner-gives-way linear both;
                    animation-timeline: --link-popover-text;
                    animation-range: 0
                        calc(var(--banner-height) - var(--banner-min-height));
                }
            }
        }
    }

    @keyframes link-popover-banner-gives-way {
        to {
            height: var(--banner-min-height);
        }
    }

    .link-popover-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-h4);
        line-height: 1.2;
    }

    .link-popover-meta {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-style: italic;
    }

    /* Justify only works because these descriptions are short (2-3 lines);
       longer text would show whitespace gaps. Hyphens avoid a ragged gap
       on the last line when a word can't break. */
    .link-popover-description {
        text-align: justify;
        hyphens: auto;
    }

    /* The facts below the summary, ruled as the site's tables are: ink over
       the first row, a hairline under each. It is spans with table roles
       rather than a <table>, because a <table> would close the paragraph
       the link sits in. */
    .link-popover-ledger {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: 0.8rem;
        margin-top: 0.5rem;
        border-top: 1.5px solid var(--color-text);
        line-height: 1.35;
        font-variant-numeric: lining-nums tabular-nums;
    }

    .link-popover-row {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        padding-block: 0.25rem;
        border-bottom: 1px solid var(--color-border);
    }

    .link-popover-key {
        @include typography.apparatus(var(--text-small));
        font-weight: 600;
    }

    @media print {
        .link-popover-anchor {
            display: none !important;
        }

        /* A printed link cannot be followed, so saying where it would have
           gone is noise. The citation below says it in words instead. */
        .link-mark {
            display: none;
        }

        .link-cite {
            display: inline;
        }
    }
</style>
