---
import { formatInlineCitation } from "./cite";
import { isCitable, isResolved, sourceFor } from "./sources";
import { getLinkMeta, hasBibliography } from "./store";
import { buildPreview } from "./preview";

export interface Props {
    href: string;
    showImage?: boolean;
    [key: string]: any;
}

const { href, showImage = false, ...rest } = Astro.props;

const entry = getLinkMeta(href);
const preview = entry && buildPreview(entry);

/**
 * Printed pages can't be clicked, so this is what appears in the link's
 * place: the "(Author, Year)" citation when the target is in the
 * bibliography, otherwise its raw address.
 */
const inBibliography = hasBibliography() && entry && isCitable(entry);
const citation =
    (inBibliography && formatInlineCitation(entry.csl)) || `(${href})`;

/**
 * Where the link leads, and whether anything was found there. Both are facts
 * the machine layer draws — see design.mdx, Annotation — and they are
 * independent: the glyph says which kind of address this is, its colour says
 * whether the address answered.
 */
const { mark } = sourceFor(href);
const resolved = isResolved(href, entry);
---

<span class="link-wrapper">
    <a href={href} {...rest} class:list={["content-link", rest.class]}>
        <slot /><span
            class:list={["link-mark", !resolved && "unresolved"]}
            aria-hidden="true">{mark}</span
        >
    </a>
    <span class="link-cite"> {citation}</span>
    {
        preview && (
            <span class="link-popover-anchor">
                <span class="link-popover" role="tooltip">
                    {showImage && preview.image && (
                        <img
                            class="link-popover-image"
                            src={preview.image}
                            alt=""
                            loading="lazy"
                        />
                    )}
                    <span class="link-popover-title">{preview.title}</span>
                    {preview.meta.length > 0 && (
                        <span class="link-popover-meta">
                            {preview.meta.join(" · ")}
                        </span>
                    )}
                    {preview.body &&
                        (preview.body.type === "html" ? (
                            <span
                                class="link-popover-description"
                                set:html={preview.body.content}
                            />
                        ) : (
                            <span
                                class="link-popover-description"
                                set:text={preview.body.content}
                            />
                        ))}
                </span>
            </span>
        )
    }
</span>

<style lang="scss">
    @use "../../../layouts/prelude/motion";
    @use "../../../layouts/prelude/ornaments";

    .link-wrapper {
        position: relative;
        display: inline;
    }

    /* Screens have the link itself; only paper needs it spelled out. */
    .link-cite {
        display: none;
    }

    /* The machine's note on where this goes, set inside the anchor so it
       travels with the link and is underlined along with it. Malachite while
       the address answered; ochre when it did not, which leaves both facts
       legible at once rather than spending a second glyph on the second one. */
    .link-mark {
        margin-left: 0.12em;
        font-weight: 400;
        font-size: 0.68em;
        vertical-align: 0.42em;
        letter-spacing: 0.04em;
        color: var(--color-signal);

        &.unresolved {
            color: var(--color-attention);
        }
    }

    /* The popover stands half a line clear of its link, and that standoff is
       padding here rather than margin on the paper: a gap the pointer can be
       over is a gap it can cross, so the popover no longer closes under a
       mouse on its way up to it. */
    .link-popover-anchor {
        position: absolute;
        bottom: 100%;
        padding-bottom: 0.5lh;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;

        /* The delay is the standoff in time that the padding above is in
           space: long enough that a pointer crossing a link on its way
           somewhere else never summons one.

           The anchor's half of the entrance is `visibility`, and only
           that. Because the box stays rendered, the pane inside it always
           has an opacity to fade from, with no `@starting-style` needed
           to find one. And because `visibility: hidden` also removes a
           subtree from the accessible tree, from find-in-page and from
           hit testing, the popover stays fully hidden while it is down,
           standoff padding included.

           The fade itself is on the pane rather than here, and has to be:
           an ancestor carrying a composited opacity is a backdrop root,
           and a backdrop root above the pane leaves its `backdrop-filter`
           with nothing behind it to blur. */
        @include motion.snap(visibility, 120ms, 0.3s);
        visibility: hidden;
    }

    /* Hovering the popover is hovering the wrapper it hangs from, so holding
       the link open and holding the popover open are the same rule. */
    .link-wrapper:hover .link-popover-anchor,
    .link-wrapper:focus-within .link-popover-anchor {
        visibility: visible;
    }

    .link-wrapper:hover .link-popover,
    .link-wrapper:focus-within .link-popover {
        opacity: 1;
        translate: 0 0;
    }

    /* A pane of the machine's glass held over the page, since what is on it is
       the machine's reading of the address rather than anything the author
       wrote. It scrolls its own contents, which is why `glass` paints the
       bounding box on the pane: a box drawn around it would be clipped. */
    .link-popover {
        @include ornaments.glass;

        /* The pane rises the last few pixels into place as it takes colour,
           and sinks back as it loses it, on the same standoff the anchor
           above waits out. */
        @include motion.snap((opacity, translate), 120ms, 0.3s);
        opacity: 0;
        translate: 0 0.35rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        width: 22rem;
        max-height: 16rem;
        overflow-y: auto;
        // Clear of the glass's edge, which stands 6px in from the ticks.
        padding: 1.1rem 1.2rem;
        color: var(--color-text);
        font-size: var(--text-small);
        line-height: 1.45;
        font-weight: normal;
    }

    .link-popover-image {
        max-width: 100%;
        max-height: 6rem;
        object-fit: cover;
    }

    .link-popover-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-h4);
        line-height: 1.2;
    }

    .link-popover-meta {
        color: var(--color-muted);
        font-size: 0.78rem;
        font-style: italic;
    }

    /* Justify only works because these descriptions are short (2-3 lines);
       longer text would show whitespace gaps. Hyphens avoid a ragged gap
       on the last line when a word can't break. */
    .link-popover-description {
        text-align: justify;
        hyphens: auto;
    }

    @media print {
        .link-popover-anchor {
            display: none !important;
        }

        /* A printed link cannot be followed, so saying where it would have
           gone is noise. The citation below says it in words instead. */
        .link-mark {
            display: none;
        }

        .link-cite {
            display: inline;
        }
    }
</style>
