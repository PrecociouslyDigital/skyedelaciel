---
/**
 * One level of a table of contents: a list of TocEntry.
 *
 * `root` marks the outermost list, which alone carries the tracker and is
 * positioned for it to be measured against — see toc.scss. Its styles are
 * global rather than scoped, because the entries are slotted in from whichever
 * component builds the tree.
 */
interface Props {
    root?: boolean;
}

const { root = false } = Astro.props;
---

<ol class:list={["toc-list", root && "toc-root"]}><slot /></ol>
