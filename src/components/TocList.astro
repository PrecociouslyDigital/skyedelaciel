---
/**
 * One level of a table of contents: a list of TocEntry, all at `depth`.
 *
 * The outermost list, at depth 1, alone carries the tracker and is positioned
 * for it to be measured against — see toc.scss. Its styles are global rather
 * than scoped, because the entries are slotted in from whichever component
 * builds the tree.
 */
interface Props {
    depth: number;
}

const { depth } = Astro.props;
---

<ol class:list={["toc-list", depth === 1 && "toc-root"]} data-depth={depth}>
    <slot />
</ol>
