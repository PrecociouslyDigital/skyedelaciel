---
import ThemeToggle from "./ThemeToggle.svelte";
---

<nav class="navbar" aria-label="Main navigation">
    {
        /* The mark is painted by CSS rather than served as an image — see the
        stylesheet below — so the anchor only has to provide a box for it. */
    }
    <a href="/" class="logo" aria-label="Home"><span></span></a>

    <div class="nav-links">
        <a href="/about">About</a>
        <a href="/writing">Writing</a>
        <a href="https://github.com/skyedelaciel" rel="noopener">GitHub</a>
    </div>

    <ThemeToggle transition:persist client:load />
</nav>

<style lang="scss">
    @use "../layouts/prelude/breakpoints";
    @use "../layouts/prelude/typography";

    .navbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem;
        max-width: 80ch;
        margin: 0 auto;
    }

    /* 朱文: the mark in vermilion line, inside a vermilion border — a seal
       stamped on the page. Drawn as a mask over the accent colour, so it is
       legible in both schemes without a second copy of the artwork. */
    .logo {
        box-sizing: border-box;
        display: block;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0.35rem;
        border: 2px solid var(--color-accent);
        border-radius: 0.2rem;

        span {
            display: block;
            width: 100%;
            height: 100%;
            background: var(--color-accent);
            mask: url("/logo.svg") center / contain no-repeat;
        }
    }

    .nav-links {
        display: flex;
        gap: 1rem;

        a {
            @include typography.apparatus;
            color: var(--color-muted);
            text-decoration: none;

            &:hover {
                color: var(--color-accent);
            }
        }
    }

    // Wide-sidebar: vertical layout (sidebar handles positioning)
    @include breakpoints.wide-sidebar {
        .navbar {
            flex-direction: column;
            align-items: flex-end;
            padding: 0;
            max-width: none;
            margin: 0;
            text-align: right;
        }

        .nav-links {
            flex-direction: column;
            align-items: flex-end;
            gap: 0.35rem;
        }
    }

    // Print: hide navbar
    @media print {
        .navbar {
            display: none;
        }
    }
</style>
