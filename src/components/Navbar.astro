---
import ThemeToggle from "./ThemeToggle.astro";
import Mark from "~/assets/logo-reduced-brush.svg";
import { hrefFor, isCurrent, navLinks, type Host } from "./nav";

interface Props {
    host: Host;
}

const { host } = Astro.props;
const site = Astro.site;
if (!site) throw new Error("astro.config.mts must set `site`.");
---

<nav class="navbar" aria-label="Main navigation">
    <a
        href={hrefFor({ label: "Home", path: "/" }, host, site)}
        class="logo"
        aria-label="Home"><Mark /></a
    >

    <div class="nav-links" data-count={navLinks.length}>
        {
            navLinks.map((link) => (
                <a
                    href={hrefFor(link, host, site)}
                    rel={"url" in link ? "noopener" : undefined}
                    aria-current={
                        isCurrent(link, host, Astro.url.pathname)
                            ? "page"
                            : undefined
                    }
                >
                    {link.label}
                </a>
            ))
        }
    </div>

    <ThemeToggle />
</nav>

<style lang="scss">
    @use "sass:math";
    @use "../layouts/prelude/breakpoints";
    @use "../layouts/prelude/motion";
    @use "../layouts/prelude/typography";

    $link-size: 1.1rem;
    $mark: 4rem;

    /* Where the sidebar holds them, they are set larger: there they have a
       column to themselves rather than a share of one band. */
    $sidebar-link-size: 1.3rem;
    $sidebar-mark: 4.5rem;

    /* Narrow: the seal, the links and the toggle share one band, unboxed.

       On the narrowest screens the band gives a little rather than wrapping:
       the seal, the type and the space round each link all shrink with
       its width (the sidebar's, which holds it; see prelude.scss), down to
       what still reads. */
    .navbar {
        display: flex;
        align-items: center;
        gap: min(0.75rem, 2cqi);
        padding: 0.5rem;
        max-width: 80ch;
        margin: 0 auto;
        // The toggle's tap area must not reach past the screen and let the
        // page scroll sideways; at the screen's edge it is not needed.
        overflow-x: clip;
    }

    /* The mark, bare. It is inlined rather than linked, so its ink can take
       the scheme's colour and its strokes can be animated. */
    .logo {
        display: block;
        flex: none;
        width: min($mark, 15cqi);
        height: min($mark, 15cqi);
        color: var(--color-text);

        :global(svg) {
            display: block;
            width: 100%;
            height: 100%;
        }

        // Only the ink: the masks inside the artwork must stay black and white.
        :global(svg > g) {
            fill: currentcolor;
        }
    }

    /* The rewrite: while the pointer is on the mark, each stroke lifts off in
       the direction it was painted and is laid straight down again the same
       way. Each stroke starts a third of a stroke after the one before, in the
       order --i gives, so about three move at once. Only arriving waits its
       turn: when the pointer leaves, every stroke turns back at once from
       wherever it had got to.

       Each stroke has pathLength="1", so its dash is exactly one stroke long,
       followed by a gap as long again. Sliding the pattern back two lengths
       carries the dash off the far end as the next comes on at the near end,
       so lifting and laying both travel in the painted direction. */
    $stroke: motion.$grow-limit;
    $stagger: math.div($stroke, 3);

    .logo :global(.logo-ink) {
        stroke-dasharray: 1 1;
        @include motion.grow(stroke-dashoffset, $stroke);
    }

    .logo:hover :global(.logo-ink) {
        stroke-dashoffset: -2;
        transition-delay: calc(var(--i) * #{$stagger});
    }

    /* Each link is a fingertip tall, in centred rows, more on top than below
       and the lower row set between the upper one's, so that no tap zone sits
       straight under another: three as two over one where they will not fit
       on a line, five as three over two. */
    .nav-links {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;

        a {
            @include typography.apparatus($link-size);
            display: grid;
            place-items: center;
            min-height: 2.75rem;
            padding-inline: min(0.55rem, 1.6cqi);
            font-size: min($link-size, 4.6cqi);
            color: var(--color-muted);
            text-decoration: none;

            &:hover {
                color: var(--color-accent);
            }

            // Where the reader is: full ink rather than a chroma, since the
            // three hands each mean something else.
            &[aria-current="page"] {
                color: var(--color-text);
            }
        }

        &[data-count="5"] {
            display: grid;
            grid-template-columns: repeat(6, auto);
            justify-content: center;

            a {
                grid-column: span 2;
                font-size: min($link-size, 4.3cqi);
            }

            a:nth-child(4) {
                grid-column: 2 / span 2;
            }
        }
    }

    // Wide-sidebar: vertical layout (sidebar handles positioning)
    @include breakpoints.wide-sidebar {
        .navbar {
            flex-direction: column;
            align-items: flex-end;
            gap: 1rem;
            padding: 0;
            max-width: none;
            margin: 0;
            overflow-x: visible;
            text-align: right;
        }

        .logo {
            width: $sidebar-mark;
            height: $sidebar-mark;
        }

        .nav-links,
        .nav-links[data-count="5"] {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 0.6rem;

            a {
                display: block;
                min-height: 0;
                padding: 0;
                font-size: $sidebar-link-size;
            }
        }
    }

    // Print: hide navbar
    @media print {
        .navbar {
            display: none;
        }
    }
</style>
