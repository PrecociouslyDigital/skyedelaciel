---
import ThemeToggle from "./ThemeToggle.svelte";
---

<nav class="navbar" aria-label="Main navigation">
    <a href="/" class="logo" aria-label="Home">
        <img src="/logo.svg" alt="" width="32" height="32" />
    </a>

    <div class="nav-links">
        <a href="/about">About</a>
        <a href="/writing">Writing</a>
        <a href="https://github.com/skyedelaciel" rel="noopener">GitHub</a>
    </div>

    <ThemeToggle transition:persist client:load />
</nav>

<style lang="scss">
    @use "../layouts/prelude/breakpoints";

    .navbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem;
        max-width: 80ch;
        margin: 0 auto;
    }

    .logo {
        display: flex;
        align-items: center;

        img {
            display: block;
        }
    }

    .nav-links {
        display: flex;
        gap: 1rem;

        a {
            text-decoration: none;
            font-family: sans-serif;
            font-size: 0.9rem;

            &:hover {
                text-decoration: underline;
            }
        }
    }

    // Wide-sidebar: vertical layout (sidebar handles positioning)
    @include breakpoints.wide-sidebar {
        .navbar {
            flex-direction: column;
            align-items: flex-end;
            padding: 0;
            max-width: none;
            margin: 0;
            text-align: right;
        }

        .nav-links {
            flex-direction: column;
            align-items: flex-end;
            gap: 0.5rem;
        }
    }

    // Print: hide navbar
    @media print {
        .navbar {
            display: none;
        }
    }
</style>
