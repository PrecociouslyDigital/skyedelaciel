{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist", "test-results", "playwright-report", ".gallery"],
    "compilerOptions": {
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "~/*": ["./src/*"]
        }
    }
}
