{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist", "test-results", "playwright-report", ".gallery"],
    "compilerOptions": {
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "~/*": ["./src/*"]
        },
        // Teaches plain tsserver to resolve `.astro` imports, so editors and
        // language-server clients agree with `astro check`.
        "plugins": [{ "name": "@astrojs/ts-plugin" }]
    }
}
